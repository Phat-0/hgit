# Sao chép thành .env ở thư mục may-chu (không commit .env)
# Lấy URI PostgreSQL từ Supabase Dashboard > Connect.
# Mã hóa ký tự đặc biệt trong mật khẩu khi đặt trong URL.
# Dùng tài khoản backend có quyền cần thiết; không đưa URI vào frontend.
DATABASE_URL=
PORT=3000

# Supabase Dashboard > Project Settings > API Keys
# Dùng publishable key (sb_publishable_...) hoặc legacy anon key; KHÔNG dùng service_role.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Chỉ đặt tại backend để tải ảnh vào bucket riêng tư và ký URL.
# Không dùng khóa này ở trang-web, không đưa lên GitHub.
SUPABASE_SERVICE_ROLE_KEY=
